    affiliation: "Pontifical Catholic University of Rio de Janeiro (PUC-Rio)"
  - family-names: "dos Santos P. Barbosa"
    given-names: "João Paulo"
    affiliation: "Pontifical Catholic University of Rio de Janeiro (PUC-Rio)"
  - family-names: "B. A. de Souza"
    given-names: "Vanndher Amós"
    affiliation: "Pontifical Catholic University of Rio de Janeiro (PUC-Rio)"
  - name: "Data Zoom (PUC-Rio)"
    email: "datazoom@econ.puc-rio.br"
    website: "https://datazoom.com.br/"
version: "0.1.1"
date-released: "2026-10-06"
license: MIT
repository-code: "https://github.com/datazoompuc/datazoom.saude"
repository-artifact: "https://CRAN.R-project.org/package=datazoom.saude"
