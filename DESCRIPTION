Package: datazoom.saude
Title: Download and Process Brazilian Public Health Data from DATASUS
Version: 0.10.0.9000
Authors@R: c(
    person("João Paulo", "dos Santos P. Barbosa", , "joao.3158129@gmail.com", role = "aut"),
    person("Luana", "Laport Santos", , "luanalaportsantos@icloud.com", role = "cre"),
    person("DataZoom (PUC-Rio)", , , "datazoom@econ.puc-rio.br", role = "fnd"),
    person("Vanndher Amós", "B. A. de Souza", , "vanndheramos@gmail.com", role = "aut")
